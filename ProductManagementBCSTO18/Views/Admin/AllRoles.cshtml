@model List<ProductManagementBCSTO18.Models.VM.Admin.RolesViewModel>

@{
    ViewData["Title"] = "All Roles";
}

<h2>All Roles</h2>

<table class="table">
    <thead>
        <tr>
            <th>Role Name</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>
                    <a asp-action="EditRole" asp-route-Id="@role.Id" class="btn btn-primary">Edit</a>
                    <a asp-action="DeleteRole" asp-route-Id="@role.Id" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this role?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

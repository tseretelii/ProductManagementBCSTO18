@model List<ProductManagementBCSTO18.Models.VM.Admin.GetAllUsersViewModel>

@{
    ViewData["Title"] = "User List";
}

    <div class="mb-3">
        <a asp-action="CreateRole" class="btn btn-primary">Create New Role</a>
        <a asp-action="AllRoles" class="btn btn-secondary">View All Roles</a>
    </div>

    <div class="container mt-4">
        <h1>@ViewData["Title"]</h1>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Create Date</th>
                    <th>Roles</th>
                    <th>
                        <a asp-action="CreateUser" class="btn btn-success btn-sm">Create User</a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>@user.CreateDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <ul>
                                @foreach (var role in user.Roles)
                                {
                                    <li>@role</li>
                                }
                            </ul>
                        </td>
                        <td>
                            <!-- Edit Button -->
                            <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-warning btn-sm">Edit</a>

                            <!-- Delete Button -->
                            <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

